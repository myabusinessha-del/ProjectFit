    def migrate_demo(self, uid):
        if uid == 'demo': return {'ok':False,'message':'Demo account cannot be migrated.'}
        if self.db.q('SELECT COUNT(*) n FROM workout_sessions WHERE user_id=?',(uid,)).fetchone()['n'] > 0:
            return {'ok':False,'message':'This account already contains workout data. Migration was not run.'}
        demo='demo'
        tables=['goals','programme','workout_sessions','measurements','nutrition_entries','activity_entries','weekly_checkins','progress_reviews']
        self.db.q('UPDATE users SET age=(SELECT age FROM users WHERE id=?),height_cm=(SELECT height_cm FROM users WHERE id=?),sex=(SELECT sex FROM users WHERE id=?),timezone=(SELECT timezone FROM users WHERE id=?) WHERE id=?',(demo,demo,demo,demo,uid))
        for t in tables:
            cols=[x['name'] for x in self.db.q(f'PRAGMA table_info({t})').fetchall() if x['name']!='id' or t not in ['goals']]
            if t=='goals':
                r=self.db.q('SELECT objective,target_weight,target_body_fat,training_frequency,calorie_target,protein_target FROM goals WHERE user_id=?',(demo,)).fetchone()
                if r:self.db.q('UPDATE goals SET objective=?,target_weight=?,target_body_fat=?,training_frequency=?,calorie_target=?,protein_target=? WHERE user_id=?',tuple(r)+ (uid,))
            elif t=='programme':
                rows=self.db.q('SELECT week,day,session,exercise,sets,rep_range,start_weight,rir,rest_seconds FROM programme WHERE user_id=?',(demo,)).fetchall()
                for r in rows:self.db.q('INSERT INTO programme(user_id,week,day,session,exercise,sets,rep_range,start_weight,rir,rest_seconds) VALUES(?,?,?,?,?,?,?,?,?,?)',(uid,*tuple(r)))
            elif t=='workout_sessions':
                rows=self.db.q('SELECT id,session_date,week,session_name,status,notes FROM workout_sessions WHERE user_id=?',(demo,)).fetchall()
                for r in rows:self.db.q('INSERT INTO workout_sessions(id,user_id,session_date,week,session_name,status,notes) VALUES(?,?,?,?,?,?,?)',(r['id']+'_'+uid,uid,r['session_date'],r['week'],r['session_name'],r['status'],r['notes']))
